{
  "expo": {
    "name": "uvelan.ultimateapp",
    "slug": "my-ultimate-app",
    "version": "1.1.32",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "my-ultimate-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#142128"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uvelan.ultimateapp",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#142128"
      },
      "package": "com.uvelan.ultimateapp",
      "permissions": [
        "READ_SMS"
      ],
      "versionCode": 36
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#142128",
          "image": "./assets/images/splash-icon.png"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withNotifeeRepo",
      "./plugins/withSmsReader",
      "./plugins/withReaderMediaSession",
      "./plugins/withKokoro"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id-placeholder"
      }
    }
  }
}
